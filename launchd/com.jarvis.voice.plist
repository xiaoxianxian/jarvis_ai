<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Jarvis voice pipeline (Hermes sessions + Whisper STT + ElevenLabs TTS).
     Serves ws://0.0.0.0:8765/ws and the HUD on https://0.0.0.0:8766/hud/.
     The wrapper waits for the Hermes gateway (8642) before launching.
     Install:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jarvis.voice.plist

     macOS quirks (learned the hard way):
     1. Invoke the VENV python via a wrapper that execs it (do NOT bash -c 'cd ...'
        onto an external volume — TCC hang; do NOT use the framework python — no
        site-packages).
     2. Log paths MUST be on the internal disk or launchd fails with EX_CONFIG.
     3. FD limits REQUIRED: launchd grants 256 by default; the server idles at
        ~244 open files (Python libs + the Whisper model) and dies within hours
        without these keys. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.jarvis.voice</string>
  <key>SoftResourceLimits</key><dict><key>NumberOfFiles</key><integer>8192</integer></dict>
  <key>HardResourceLimits</key><dict><key>NumberOfFiles</key><integer>8192</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/xiaota/Library/Logs/jarvis-voice.log</string>
  <key>StandardErrorPath</key><string>/Users/xiaota/Library/Logs/jarvis-voice.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/xiaota/jarvis-ai/server/scripts/run_voice.sh</string>
  </array>
</dict></plist>
