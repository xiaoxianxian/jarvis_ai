<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hermes desktop backend (the agent runtime the gateway talks to), bound to
     loopback 127.0.0.1:9119. Headless (--skip-build, no Electron window).
     Install:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jarvis.dashboard.plist
     This is the 'hermes serve' backend; the gateway (8642) and the voice
     pipeline (8765/8766) are separate services. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.jarvis.dashboard</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/xiaota/Library/Logs/jarvis-dashboard.log</string>
  <key>StandardErrorPath</key><string>/Users/xiaota/Library/Logs/jarvis-dashboard.log</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key><array>
    <string>/Users/xiaota/.hermes/hermes-agent/venv/bin/hermes</string>
    <string>serve</string>
    <string>--skip-build</string>
  </array>
</dict></plist>
